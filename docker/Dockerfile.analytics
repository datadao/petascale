# syntax=docker/dockerfile:1
# Analytics image — includes duckdb + plotly for dashboard generation and cold aggregation.
# NOT used for the ingest daemon (keep that image lean).

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra analytics --no-install-project

COPY src/ src/
RUN uv sync --frozen --no-dev --extra analytics

FROM python:3.12-slim-bookworm

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY src/            src/
COPY scripts/        scripts/
COPY config/         config/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    PYTHONUNBUFFERED=1

VOLUME ["/data"]

# Default: regenerate dashboard every 5 minutes, export Parquet nightly
CMD ["sh", "-c", "\
  while true; do \
    python scripts/dashboard.py; \
    python -m petascale.cold.aggregator; \
    sleep 300; \
  done"]
