# MQTT broker (primary data source — ESP32 sensors publish here)
MQTT_HOST=mqtt.local
MQTT_PORT=1883
MQTT_USERNAME=petascale
MQTT_PASSWORD=changeme

# Database
DB_PATH=petascale.db

# Home Assistant (used for batch backfill only, not needed for live ingestion)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token_here
# Sensor config lives in config/sensors.toml
